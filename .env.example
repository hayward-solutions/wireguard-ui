# =============================================================================
# WireGuard UI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values.
# Lines starting with # are comments; uncomment to override defaults.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
# The app rejects weak/default values and enforces minimum lengths.

ADMIN_PASSWORD=
JWT_SECRET=              # min 16 characters
ENCRYPTION_KEY=          # min 16 characters, must differ from JWT_SECRET
WG_ENDPOINT=vpn.example.com:51820

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# LISTEN_ADDR=:8080
# BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# DATABASE_DRIVER=sqlite
# DATABASE_DSN=/data/wireguard.db

# -----------------------------------------------------------------------------
# WireGuard
# -----------------------------------------------------------------------------

# WG_ADDRESS=10.0.0.1/24
# WG_LISTEN_PORT=51820
# WG_DNS=1.1.1.1,8.8.8.8
# WG_DEFAULT_ALLOWED_IPS=0.0.0.0/0, ::/0
# WG_INTERFACE_NAME=wg0
# WG_MTU=1420
# WG_USERSPACE_MODE=true
# WG_NETSTACK_MODE=false
# WG_MOCK_MODE=false

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# ADMIN_USERNAME=admin
# ADMIN_API_KEY=          # deprecated — use per-user API tokens instead

# OIDC (all three required to enable)
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=      # defaults to {BASE_URL}/auth/callback
# OIDC_SCOPES=openid,profile,email
# OIDC_ADMIN_GROUP=
# OIDC_GROUPS_CLAIM=cognito:groups

# Authentication Policies
# ALLOW_PASSWORDLESS_LOGIN=true
# MFA_REQUIRED=false

# -----------------------------------------------------------------------------
# Tunnels
# -----------------------------------------------------------------------------

# TUNNEL_PEERS=            # JSON array of tunnel peer configs (first-boot provisioning)
# TUNNEL_SUBNET=10.100.0.0/16

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# REQUIRE_HTTPS=false
# CORS_ORIGINS=            # comma-separated origins
# TRUSTED_PROXIES=         # comma-separated IPs
# ALLOW_CUSTOM_SCRIPTS=false

# -----------------------------------------------------------------------------
# Other
# -----------------------------------------------------------------------------

# JWT_EXPIRY=15m
# SESSION_EXPIRY=168h
# STATS_INTERVAL=10s
# API_TOKEN_MAX_LIFETIME=2160h   # 90 days
# DEV_MODE=false
